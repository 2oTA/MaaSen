{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaSen",
    "description": "织梦森林自动化工具",
    "contact": "GitHub Issues: https://github.com/2oTA/MaaSen/issues",
    "license": "MIT",
    "welcome": "欢迎使用 MaaSen！使用前请把模拟器停在游戏所在桌面，并确认游戏图标可见。使用说明见 GitHub 仓库 README。",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/2oTA/MaaSen",
    "version": "0.1.1",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    // 自定义识别/动作（如「更新数据」）由 Python Agent 提供
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "进入游戏",
            "entry": "LaunchGame",
            "default_check": true,
            "description": "从模拟器桌面点击游戏图标 → 等待加载 → 点击「进入森林」→ 关闭开屏广告 → 点击主界面的森林入口"
        },
        {
            "name": "复位视野",
            "entry": "ResetView",
            "default_check": true,
            "description": "缩放到最小并将镜头拖回中央。与「进入游戏」一起勾选时会在进入森林后自动执行"
        },
        {
            "name": "更新数据",
            "entry": "UpdateFlowerData",
            "default_check": false,
            "description": "进入花房读取已拥有的花，结果写入 config/flowers.json，并按已获得的花刷新「种植花朵」候选（重启 MFAAvalonia 后生效）"
        },
        {
            "name": "种植",
            "entry": "PlantPlot",
            "default_check": false,
            "option": [
                "种植地块",
                "种植花朵"
            ],
            "description": "在选定地块的空地上种下选定的花：点空地 → 在种植列表里找花名 → 点花名上方的花朵 → 按住拖过剩余空地"
        }
    ],
    "option": {
        "种植地块": {
            "type": "select",
            "default_case": "地块1",
            "cases": [
                {
                    "name": "地块1",
                    "pipeline_override": {
                        "PlantPlot": {
                            "custom_action_param": {
                                "plot": 1
                            }
                        }
                    }
                },
                {
                    "name": "地块2",
                    "pipeline_override": {
                        "PlantPlot": {
                            "custom_action_param": {
                                "plot": 2
                            }
                        }
                    }
                },
                {
                    "name": "地块3",
                    "pipeline_override": {
                        "PlantPlot": {
                            "custom_action_param": {
                                "plot": 3
                            }
                        }
                    }
                },
                {
                    "name": "地块4",
                    "pipeline_override": {
                        "PlantPlot": {
                            "custom_action_param": {
                                "plot": 4
                            }
                        }
                    }
                },
                {
                    "name": "地块5",
                    "pipeline_override": {
                        "PlantPlot": {
                            "custom_action_param": {
                                "plot": 5
                            }
                        }
                    }
                },
                {
                    "name": "地块6",
                    "pipeline_override": {
                        "PlantPlot": {
                            "custom_action_param": {
                                "plot": 6
                            }
                        }
                    }
                },
                {
                    "name": "全部地块",
                    "pipeline_override": {
                        "PlantPlot": {
                            "custom_action_param": {
                                "plot": 0
                            }
                        }
                    }
                }
            ]
        },
        // >>> 种植花朵候选（由「更新数据」按 config/flowers.json 的 owned 自动重写，勿手改；本项必须是 option 的最后一项）
        "种植花朵": {
            "type": "select",
            "default_case": "白百合",
            "cases": [
                {
                    "name": "白百合",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "白百合"
                            }
                        }
                    }
                },
                {
                    "name": "雏菊",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "雏菊"
                            }
                        }
                    }
                },
                {
                    "name": "尤加利叶",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "尤加利叶"
                            }
                        }
                    }
                },
                {
                    "name": "铃兰",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "铃兰"
                            }
                        }
                    }
                },
                {
                    "name": "红郁金香",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "红郁金香"
                            }
                        }
                    }
                },
                {
                    "name": "粉郁金香",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "粉郁金香"
                            }
                        }
                    }
                },
                {
                    "name": "勿忘我",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "勿忘我"
                            }
                        }
                    }
                },
                {
                    "name": "梦·瑶池花梦",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "梦·瑶池花梦"
                            }
                        }
                    }
                },
                {
                    "name": "金鲤锦荷",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "金鲤锦荷"
                            }
                        }
                    }
                },
                {
                    "name": "有凤来仪",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "有凤来仪"
                            }
                        }
                    }
                },
                {
                    "name": "杏花微雨",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "杏花微雨"
                            }
                        }
                    }
                },
                {
                    "name": "玉兔月华",
                    "pipeline_override": {
                        "Plant": {
                            "custom_action_param": {
                                "flower": "玉兔月华"
                            }
                        }
                    }
                }
            ]
        }
        // <<< 种植花朵候选
    }
}
