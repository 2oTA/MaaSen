{
    // 更新数据：在花房读取已拥有的花，写入 config/flowers.json，最后回到森林主界面
    "UpdateFlowerData": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        // 等待花房按钮出现；不在主界面时先点返回
        "timeout": 5000,
        "next": [
            "GreenhouseNav"
        ],
        "on_error": [
            "BackButton",
            "SaveScreenForDebug"
        ]
    },
    "GreenhouseNav": {
        "recognition": "TemplateMatch",
        "template": "greenhouse.png",
        "green_mask": true,
        "threshold": 0.7,
        "action": "Click",
        // 等待花房页面加载
        "post_delay": 2000,
        "next": [
            "ScanFlowers"
        ]
    },
    "BackButton": {
        "recognition": "TemplateMatch",
        "template": "back.png",
        "action": "Click",
        "post_delay": 1000,
        // 最多连续返回 5 次，避免死循环
        "max_hit": 5,
        "next": [
            "UpdateFlowerData"
        ],
        "on_error": [
            "SaveScreenForDebug"
        ]
    },
    "ScanFlowers": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "scan_flowers",
        "custom_action_param": {
            // 花名列表区域（720x1280 坐标）
            "roi": [
                27,
                266,
                663,
                712
            ],
            // 向下滚动一屏的 50% 左右，避免跳过「未获得」分隔行
            "scroll": {
                "begin": [
                    360,
                    900
                ],
                "end": [
                    360,
                    560
                ],
                "duration": 700,
                "delay": 700
            },
            "max_scrolls": 30,
            "library": "resource/花朵库.txt",
            "output": "config/flowers.json"
        },
        "next": [
            "ReturnToForest"
        ],
        // 扫描动作耗时不短，这里只控制等待返回按钮的时间
        "timeout": 5000,
        "on_error": [
            "SaveScreenForDebug"
        ]
    },
    "ReturnToForest": {
        "recognition": "TemplateMatch",
        "template": "forest.png",
        "green_mask": true,
        // 底部导航的森林按钮，阈值略低一些以适配不同背景
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 1500
    },
    // 供 scan_flowers 调用：对花名区域做一次 OCR
    "FlowerListOCR": {
        "recognition": "OCR",
        "roi": [
            27,
            266,
            663,
            712
        ]
    }
}
