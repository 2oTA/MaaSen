{
    // 进入游戏：模拟器桌面点击游戏图标 → 等待加载 → 点击「进入森林」→ 关闭开屏广告 → 点击主界面的森林入口
    "LaunchGame": {
        "recognition": "TemplateMatch",
        "template": "appIcon.png",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 1000,
        // 等待游戏启动动画与加载结束，直到「进入森林」出现
        "timeout": 180000,
        "next": [
            "EnterForest"
        ],
        // 游戏已经在标题界面时可以直接点「进入森林」
        "on_error": [
            "EnterForest",
            "SaveScreenForDebug"
        ]
    },
    "EnterForest": {
        "recognition": "OCR",
        "expected": "进入森林",
        "action": "Click",
        "post_delay": 1000,
        // 等待开屏广告出现；没有广告时超时后直接去等主界面
        "timeout": 30000,
        "next": [
            "CloseAd"
        ],
        "on_error": [
            "WaitMainScene"
        ]
    },
    "CloseAd": {
        "recognition": "TemplateMatch",
        "template": "close.png",
        "rate_limit": 500,
        "action": "Click",
        // 防止关闭按钮常驻时无限点击
        "max_hit": 10,
        "timeout": 1500,
        // 连续关闭叠在一起的多个广告
        "next": [
            "CloseAd"
        ],
        "on_error": [
            "WaitMainScene"
        ]
    },
    "WaitMainScene": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        // 等待主界面加载完成，轮询森林入口
        "timeout": 60000,
        "next": [
            "GoForest"
        ],
        "on_error": [
            "SaveScreenForDebug"
        ]
    },
    "GoForest": {
        "recognition": "TemplateMatch",
        "template": "forest.png",
        "green_mask": true,
        "action": "Click",
        // 保留原有双击，避免个别情况下第一次点击未被响应
        "repeat": 2,
        "repeat_delay": 300,
        "post_delay": 1000
    },
    "SaveScreenForDebug": {
        "recognition": "DirectHit",
        "action": "Screencap"
    }
}
