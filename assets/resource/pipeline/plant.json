{
    // 种植：在选定地块的空地上，种下「更新数据」里已拥有的花
    // 「种植地块」是复选框：每块地对应一个 PlantSelect 节点，勾选后由选项把 plot 改成地块号，
    // 没勾选的就保持 0（跳过）；6 个节点依次串联，最后由 Plant 统一执行种植
    "PlantSelect1": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "plot_select",
        // 0 表示不种这块地；勾选「地块1」时由选项覆盖成 1
        "custom_action_param": {
            "plot": 0
        },
        "timeout": 1000,
        "next": [
            "PlantSelect2"
        ]
    },
    "PlantSelect2": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "plot_select",
        "custom_action_param": {
            "plot": 0
        },
        "timeout": 1000,
        "next": [
            "PlantSelect3"
        ]
    },
    "PlantSelect3": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "plot_select",
        "custom_action_param": {
            "plot": 0
        },
        "timeout": 1000,
        "next": [
            "PlantSelect4"
        ]
    },
    "PlantSelect4": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "plot_select",
        "custom_action_param": {
            "plot": 0
        },
        "timeout": 1000,
        "next": [
            "PlantSelect5"
        ]
    },
    "PlantSelect5": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "plot_select",
        "custom_action_param": {
            "plot": 0
        },
        "timeout": 1000,
        "next": [
            "PlantSelect6"
        ]
    },
    "PlantSelect6": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "plot_select",
        "custom_action_param": {
            "plot": 0
        },
        "timeout": 1000,
        "next": [
            "Plant"
        ]
    },
    "Plant": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "plant_flowers",
        // 由「种植花朵」选项覆盖；其余是调参用的默认值
        "custom_action_param": {
            "flower": "白百合",
            // 种植列表区域（720x1280）：原始 35:920 ~ 855:1395
            "list_roi": [
                28,
                736,
                656,
                380
            ],
            // OCR 文字框中心再往上偏移，按到文字上方的花朵图片
            "name_offset_y": -50,
            "max_list_scrolls": 6,
            "max_attempts": 3,
            "max_passes": 8,
            "vacant_threshold": 0.7,
            "move_steps": 6,
            "move_duration": 500,
            // 从花朵拖到「第一个」空地时走得更快，避免路过别的空地时把它们也种上
            "first_move_steps": 3,
            "first_move_duration": 150,
            // 按住花朵后先停一下，让游戏确认「拿起」了这朵花
            "press_hold": 0.5,
            // 每移动到一个空地后停一下，等种植动画播完再重新识别
            "hold": 0.35
        },
        "timeout": 5000,
        "next": [],
        "on_error": [
            "SaveScreenForDebug"
        ]
    },
    // 空地识别：地块包围盒由动作内按地块号覆盖 roi
    "VacantLand": {
        "recognition": "TemplateMatch",
        "template": [
            "vacant land.png"
        ],
        "green_mask": true,
        "threshold": 0.7
    },
    // 种植列表的花名 OCR
    "PlantListOCR": {
        "recognition": "OCR",
        "roi": [
            28,
            736,
            656,
            380
        ]
    }
}
