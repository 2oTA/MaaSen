{
    // 浇水：把农田里缺水的土地浇一遍
    // 识别「缺水的地」→ 点一下让游戏弹出洒水壶 → 按住洒水壶拖过所有缺水的地，浇完才松手
    "Water": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "water_plots",
        "custom_action_param": {
            // 农田整体区域（720x1280）：比 6 块地的并集再宽松一些，镜头稍微缩放/平移也能扫到
            "farm_roi": [
                30,
                500,
                660,
                420
            ],
            // 真正缺水的地在 0.75~0.80，没缺水的格子在被地块四边形卡掉后最多到 0.63，
            // 0.65 正好卡在两堆中间；真机偏模糊的话可以再往下调到 0.6
            "water_threshold": 0.65,
            "can_threshold": 0.7,
            // 只认落在 6 块地四边形内的缺水格子：整块地皮识别分只有 0.6 左右，
            // 和没缺水的格子分数混在一起，所以模板换成只截水滴的小图（见 WaterScarceLand），
            // 再用地块四边形把范围卡死
            "only_in_plots": true,
            // 按住洒水壶后先停一下，让游戏确认「拿起」了
            "press_hold": 0.5,
            // 每移动到一块缺水的地之后停一下，等浇水动画播完再重新识别
            "hold": 0.35,
            "move_steps": 6,
            "move_duration": 500,
            "max_passes": 16,
            // 一轮扫完还有没浇到的就再来一轮
            "max_rounds": 3,
            // 点完缺水的地之后，等洒水壶弹出来的时间
            "click_wait": 1.0
        },
        "timeout": 5000,
        "next": [],
        "on_error": [
            "SaveScreenForDebug"
        ]
    },
    // 缺水的地：只截「滴水的水滴」那一小块（从 waterScarce land.png 里裁 20×26），
    // 整块地皮做模板时没缺水的格子也能到 0.6，切小以后真正缺水的地 ≥0.74、其余 ≤0.65，分得开
    "WaterScarceLand": {
        "recognition": "TemplateMatch",
        "template": [
            "water drop.png"
        ],
        "green_mask": true,
        "threshold": 0.7
    },
    // 浇水用的洒水壶，点完缺水的地后出现在界面上
    "WateringCan": {
        "recognition": "TemplateMatch",
        "template": [
            "watering can.png"
        ],
        "green_mask": true,
        "threshold": 0.7
    }
}
